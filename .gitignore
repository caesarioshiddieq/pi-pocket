# deps: the trailing-slash form only matches a real dir, so the bare form also
# catches a stray node_modules symlink (seen 2026-10-31, broke the service).
node_modules/
node_modules
# What an update from the app keeps while it works (src/server/update-state.ts).
/.pocket-update/
*.log
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
result
result-*

# Folders docker-compose.yml mounts from the host; user data, never tracked.
/data/

# What `npm pack` makes.
/*.tgz
